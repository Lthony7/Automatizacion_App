{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "jest"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "domain-contracts": ["packages/domain-contracts/src/index.ts"],
      "domain-contracts/*": ["packages/domain-contracts/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
