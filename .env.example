# Content Automation Platform - Environment Configuration

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/content_automation?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000

# API Keys (never store in plain text in production - use secret management)
API_KEY_PREFIX=sk_

# Multi-Tenancy
TENANT_DEFAULT_PLAN=free

# Observability
SENTRY_DSN=https://example@sentry.io/123

# AI Providers - Configura al menos UNO para que la generación de contenido funcione:
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# (Opcional) Forzar un proveedor específico: gemini | openai | groq
# Si no se define, usa el primero que tenga API key configurada.
AI_PROVIDER=
